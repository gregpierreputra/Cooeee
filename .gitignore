# Local configs and env files. Named one by one, so a new dotfile or folder is
# reviewed rather than silently untracked.
.cache/
.claude/
.env
.env.*
.DS_Store

# Local documentation
docs/*

# Node modules
node_modules/

# Local development and testing
dist/
dev-dist/

# Local testing and code coverage
coverage/
playwright-report/
test-results/
*.local

# API server database and its daily snapshots
server/data/

# Vercel web application
.vercel/
